{
  "buildCommand": "cd client && npm install --include=dev && npm run build",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/nrai18/AttendX/releases/latest/download/AttendX.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://attendx-backend-fh6k.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
